    <Routine name="WELCOME1"/>
    <LoopInitiator loopType="TrialHandler" name="ENSAYO">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[{'tipo': 'texto', 'opacidad_texto': 1.0, 'volumen_audio': 0.0}, {'tipo': 'audio', 'opacidad_texto': 0.0, 'volumen_audio': 1.0}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="CONDICIONES.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="code"/>
      <Param name="name" updates="None" val="ENSAYO" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="ENSAYO"/>
    <Routine name="DESPEDIDA"/>
  </Flow>
</PsychoPy2experiment>
